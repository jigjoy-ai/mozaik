{
	"compilerOptions": {
		"target": "es2018",
		"module": "esnext",
		"lib": ["es2018", "dom"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "./dist",
		"rootDir": ".",
		"strict": true,
		"moduleResolution": "bundler",
		"types": ["node"],
		"paths": {
			"@application/*": ["./src/application/*"],
			"@domain/*": ["./src/domain/*"],
			"@infrastructure/*": ["./src/infrastructure/*"],
			"@network/*": ["./packages/network/*"]
		},
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src", "tests", "packages"],
	"exclude": ["node_modules", "dist"]
}
